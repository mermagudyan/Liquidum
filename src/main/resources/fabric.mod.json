{
	"schemaVersion": 1,
	"id": "liquidum",
	"version": "${version}",
	"name": "Liquidum",
	"description": "Liquid Glass effect for Minecraft UI — refraction, blur, chromatic aberration, Fresnel, and liquid button merging",
	"authors": [
		"Liquidum Team"
	],
	"contact": {
		"homepage": "https://github.com/liquidum/liquidum"
	},
	"license": "LGPL-3.0",
	"icon": "assets/liquidum/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.liquidum.LiquidumMod"
		],
		"client": [
			"com.liquidum.client.LiquidumClient"
		]
	},
	"mixins": [
		"liquidum.mixins.json",
		{
			"config": "liquidum.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.0",
		"minecraft": ">=26.0 <27",
		"java": ">=25",
		"fabric-api": "*"
	}
}
